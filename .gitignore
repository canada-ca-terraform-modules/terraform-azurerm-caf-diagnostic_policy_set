#  Local .terraform directories
**/.terraform/*

# .terraform.lock.hcl (module repo: not a root config, don't pin provider hashes)
.terraform.lock.hcl

# .tfstate files
*.tfstate
*.tfstate.*

# .tfplan files
*.tfplan

# .tfvars files
*.tfvars
# keep the tracked live-test fixture
!test/live/config/*.tfvars

# crash logs and overrides
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

#vscode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
